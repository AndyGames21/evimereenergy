<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evimere Energy Technologies</title>
    <link rel="stylesheet" href="/css/home.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="preload" as="image" href="/images/homepage.webp">
    <link rel="shortcut icon" href="/images/logo.png" type="image/x-icon">
</head>
<body>
    <main>
        <header>
            <nav class="navbar">
                <div class="logo">
                    <img src="/images/logo.png" alt="Logo" class="logo-image">
                    <span>Evimere Energy Technologies NIG. LTD</span>
                </div>

                <div class="menu-toggle" id="mobile-menu">
                    <span class="bar"></span>
                    <span class="bar"></span>
                    <span class="bar"></span>
                </div>

                <ul class="nav-links">
                    <li><a href="/" class="active">Home</a></li>
                    <li><a href="/about">About</a></li>
                    <li><a href="/services">Services</a></li>
                    <li><a href="/contact">Contact</a></li>
                </ul>
            </nav>
        </header>
    <section id="home" class="page-section">
            <main class="hero">
            <div class="hero-overlay"></div>
            <div class="hero-content">
                <h1>Innovating Sustainable Energy <br><span>Solutions for Nigeria</span></h1>
                <div class="cta-buttons">
                    <a href="/services" class="btn btn-primary">EXPLORE SERVICES</a>
                    <a href="/contact" class="btn btn-outline">GET A QUOTE</a>
                </div>
            </div>
        </main>
    </section>
    <section id="about" class="page-section styles">
        <div class="about-content">
            <h2>About Evimere Energy Technologies</h2>
            <p>
                Evimere Energy Technologies is a premier <strong>EPCI (Engineering, Procurement, Construction, and Installation)</strong> firm 
                dedicated to delivering high-complexity energy infrastructure across Nigeria. We provide a single point of accountability 
                by integrating world-class engineering design with strategic procurement and robust construction management.
            </p>
        </div>
    </section>
    <section id="services" class="page-section styles">
        <div class="services-container">
            <h2>Our Services</h2>
            <div class="service-cards"> 
                
                <div class="service-card">
                    <h3>EPCI (Engineering, Procurement, Construction And Installation)</h3>
                    <p>We provide end-to-end project management, delivering comprehensive energy infrastructure...</p>
                </div>

                <div class="service-card">
                    <h3>Civil Works</h3>
                    <p>We deliver robust structural engineering and site development services...</p>
                </div>

                <div class="service-card">
                    <h3>Sustainable Development Projects</h3>
                    <p>We partner with communities and businesses to promote sustainable growth...</p>
                </div>

            </div> </div>
    </section>
    <section id="contact" class="page-section styles">
        <div class="contact-container">
            <h2 class="section-title">CONTACT US</h2>
            
            <div class="contact-grid">
                <div class="contact-info">
                    <div class="info-block">
                        <span class="label">LOCATION</span>
                        <p>
                            New Road, Plot 13, Road 7,<br>
                            2nd Avenue Rumuakania II,<br>
                            Off Ada George, Port Harcourt,<br>
                            Nigeria
                        </p>
                </div>
                    <div class="info-block">
                        <span class="label">DIRECT EMAIL</span>
                        <p><a href="mailto:info@evimere.com">info@evimere.com</a></p>
                    </div>
                    <div class="info-block">
                        <span class="label">PHONE NUMBER</span>
                        <p><a href="tel:+2348033106002">+234 803 310 6002</a></p>
                    </div>
                </div>
                <form id="contact-form" class="contact-form">
                    <div class="input-row">
                        <div class="form-group">
                            <input type="text" name="firstName" placeholder="First Name" required>
                        </div>
                        <div class="form-group">
                            <input type="email" name="email" placeholder="Email Address" required>
                        </div>
                    </div>
                    <div class="form-group-full">
                        <textarea name="message" rows="5" placeholder="How may we assist you..." required></textarea>
                    </div>
                    <button type="submit" class="btn-submit" id="contactBtn">ENQUIRE NOW</button>
                    <div id="form-status" class="form-status"></div>
                </form>
            </div>
        </div>
    </section>
    <div class="scroll-controls">
        <button id="scroll-up" class="scroll-btn hidden" aria-label="Scroll Up">
            <span class="icon">↑</span>
        </button>
        <button id="scroll-down" class="scroll-btn" aria-label="Scroll Down">
            <span class="icon">↓</span>
        </button>
    </div>
<script src="/js/home.js"></script>
<%- include('partials/footer') %>
